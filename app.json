{
  "expo": {
    "name": "GridSketch",
    "slug": "gridsketch",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/app-icon.png",
    "scheme": "gridsketch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "supportsTablet": true,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "com.adityasonawane.gridsketch",
      "adaptiveIcon": {
        "backgroundColor": "#6A5BEF",
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundImage": "./assets/images/adaptive-background.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6253EC",
          "image": "./assets/images/splash-art.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GridSketch needs your photos so you can pick a reference image.",
          "cameraPermission": "GridSketch uses the camera to photograph your reference or your doodles.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "GridSketch saves exported images to your photo library.",
          "savePhotosPermission": "GridSketch saves exported images to your photo library.",
          "granularPermissions": []
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#6253EC"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0C0C0F",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a930d804-548f-482c-83fe-db84f9034cc6"
      }
    },
    "owner": "adityasonawane"
  }
}
